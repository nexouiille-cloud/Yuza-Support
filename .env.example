# ============================================================
#  Copie ce fichier en ".env" et remplis les valeurs.
#  (Developer Portal : https://discord.com/developers/applications)
# ============================================================

# --- Application / Bot Discord ---
BOT_TOKEN=colle-ici-le-token-du-bot
CLIENT_ID=colle-ici-le-client-id-de-l-application
CLIENT_SECRET=colle-ici-le-client-secret

# --- Serveur Discord ---
# ID du serveur sur lequel on vérifie les rôles staff
GUILD_ID=id-de-ton-serveur

# Rôles autorisés à ouvrir le launcher (IDs séparés par des virgules)
# ex: 123456789012345678,987654321098765432
STAFF_ROLE_IDS=id-du-role-staff

# IDs Discord des "owners" : accès COMPLET aux Réglages (le reste du staff
# ne peut changer que les couleurs). Vide = le niveau le plus élevé a l'accès.
OWNER_IDS=

# --- Serveur web + backend ---
PORT=53134
# 127.0.0.1 = accessible uniquement depuis ce PC (dev).
# 0.0.0.0   = accessible depuis l'extérieur (hébergement 24/7).
HOST=127.0.0.1

# DOIT être identique, au caractère près, à une "Redirect" ajoutée
# dans Developer Portal > OAuth2 > Redirects.
# Local : http://127.0.0.1:53134/auth/callback
# Hébergé : https://ton-domaine/auth/callback
OAUTH_REDIRECT_URI=http://127.0.0.1:53134/auth/callback

# Chaîne aléatoire longue pour signer les sessions du launcher
# (génère-en une : n'importe quels 40+ caractères au hasard)
SESSION_SECRET=remplace-moi-par-une-longue-chaine-aleatoire

# Suffixe ajouté après le nom du staff dans le MP du client
STAFF_SUFFIX=(Staff)

# Re-vérification du rôle staff (secondes) sur les launchers connectés
ROLE_RECHECK_SECONDS=300

# --- Annonce des nouveaux tickets (optionnel) ---
# ID du salon Discord où le bot poste "X a ouvert un ticket"
# (laisse vide pour désactiver). Le bot doit pouvoir écrire dans ce salon.
STAFF_CHANNEL_ID=
# Rôle mentionné dans l'annonce (laisse vide = 1er rôle de STAFF_ROLE_IDS)
STAFF_PING_ROLE_ID=

# --- Hiérarchie / escalade (optionnel) ---
# Niveaux au-dessus du support de base, du PLUS BAS au PLUS HAUT.
# Format : Nom:roleID  séparés par des virgules.
# Un staff qui a le rôle d'un niveau ne voit plus les tickets escaladés
# à un niveau au-dessus du sien.
# ex : STAFF_TIERS=Responsable:111111111111111111,Admin:222222222222222222
STAFF_TIERS=

# --- Web Push / pièces jointes (optionnel) ---
# Contact requis par les serveurs de push (juste une adresse mail).
PUSH_CONTACT=mailto:toi@exemple.com
# Taille max d'une pièce jointe staff -> client (octets, défaut 25 Mo).
MAX_ATTACHMENT_BYTES=26214400
# Clés VAPID : générées automatiquement dans server/vapid.json au 1er lancement.
# Pour les fixer toi-même : VAPID_PUBLIC= et VAPID_PRIVATE=

# Statut du bot (defaut si non defini dans le site). Une ligne par bio pour un defilement.
BOT_ACTIVITY=
BOT_ACTIVITY_TYPE=custom
