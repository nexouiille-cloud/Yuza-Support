{
  "name": "yuza-launcher-app",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.yuza.launcher",
    "productName": "Yuza Launcher",
    "directories": { "output": "../dist" },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "assets/icon.png",
      "assets/icon.ico"
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Yuza Launcher",
      "deleteAppDataOnUninstall": true,
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "YuzaLauncher-portable-${version}.exe"
    }
  }
}
